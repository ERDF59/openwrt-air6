#!/bin/sh /etc/rc.common
# Air6 5G 模组状态采集器的 procd 包装。
# 真正的采集循环在 /usr/bin/air6-modem-status（移植自 AIR6 的同名程序）。

START=95
STOP=05
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/air6-modem-status
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
