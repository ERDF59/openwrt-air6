#!/bin/sh
# Read-only vendor API collector. Completed snapshots are published atomically.
# Each worker has a hard deadline; a stalled RIL cannot block rpcd or the UI.
umask 077
SNAP=/tmp/air6-modem-status.json
NEW=/tmp/air6-modem-status.$$.json
LOCK=/tmp/air6-modem-status-api.lock
exec 9>"$LOCK"
flock -n 9 || exit 0
trap 'rm -f "$NEW"; exit 0' INT TERM
interval="$(uci -q get air6_modem_status.main.poll_seconds)"
case "$interval" in ''|*[!0-9]*) interval=5;; esac
[ "$interval" -ge 2 ] && [ "$interval" -le 60 ] || interval=5
while :; do
    if timeout 20 /usr/bin/air6-nw-api >"$NEW" 2>/tmp/air6-modem-api-error; then
        chmod 600 "$NEW"
        mv -f "$NEW" "$SNAP"
    else
        rm -f "$NEW"
    fi
    sleep "$interval"
done
