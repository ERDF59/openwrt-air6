#!/bin/sh
# Air6 5G 模组状态采集器
#
# 移植自 AIR6 的 air6-modem-chain-status：同一个 MT6990 集成模组，
# 但那版依赖厂商私有的 show_register_status / nw_get_signal，
# 本固件的 mipc_wan_cli 没有这两个，因此注册、RAT、信号改走 atcid 的 AT。
#
# 采集结果写 /tmp/air6-modem-status.state，供 LuCI 后端（luci.air6modem）读取。

STATE=/tmp/air6-modem-status.state
STATE_NEW="/tmp/air6-modem-status.$$.new"
LOCK=/var/lock/luci-air6modem-control.lock
CLI=/usr/bin/mipc_wan_cli
ATCLI=/usr/bin/air6-modem-at
IFACE=wan
[ "$(/sbin/uci -q get network.modem5g)" = interface ] && IFACE=modem5g

config_load() {
	[ -f /etc/config/air6_modem_status ] || return 0
	. /lib/functions.sh
	config_load air6_modem_status || return 0
	config_get start_delay main start_delay 25
	config_get poll_seconds main poll_seconds 5
	config_get registration_interval main registration_interval 20
	config_get radio_interval main radio_interval 60
	config_get identity_interval main identity_interval 1800
	config_get detail_interval main detail_interval 300
	config_get temp_interval main temp_interval 60
}

clean_value() {
	printf '%s' "$1" | tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

# LTE EARFCN -> 频段（只覆盖常见段；落在空洞里就返回 LTE）
lte_band() {
	e="$1"
	[ -n "$e" ] || return
	if   [ "$e" -ge 0 ]     && [ "$e" -le 599 ];   then echo "B1"
	elif [ "$e" -ge 600 ]   && [ "$e" -le 1199 ];  then echo "B2"
	elif [ "$e" -ge 1200 ]  && [ "$e" -le 1949 ];  then echo "B3"
	elif [ "$e" -ge 1950 ]  && [ "$e" -le 2399 ];  then echo "B4"
	elif [ "$e" -ge 2400 ]  && [ "$e" -le 2649 ];  then echo "B5"
	elif [ "$e" -ge 2750 ]  && [ "$e" -le 3449 ];  then echo "B7"
	elif [ "$e" -ge 3450 ]  && [ "$e" -le 3799 ];  then echo "B8"
	elif [ "$e" -ge 6150 ]  && [ "$e" -le 6449 ];  then echo "B20"
	elif [ "$e" -ge 9210 ]  && [ "$e" -le 9659 ];  then echo "B28"
	elif [ "$e" -ge 36200 ] && [ "$e" -le 36349 ]; then echo "B34"
	elif [ "$e" -ge 37750 ] && [ "$e" -le 38249 ]; then echo "B38"
	elif [ "$e" -ge 38250 ] && [ "$e" -le 38649 ]; then echo "B39"
	elif [ "$e" -ge 38650 ] && [ "$e" -le 39649 ]; then echo "B40"
	elif [ "$e" -ge 39650 ] && [ "$e" -le 41589 ]; then echo "B41"
	else echo "LTE"
	fi
}

# NR-ARFCN -> 频段（常见 n41/n77/n78/n79/n1/n3/n28）
nr_band() {
	a="$1"
	[ -n "$a" ] || return
	if   [ "$a" -ge 422000 ] && [ "$a" -le 434000 ]; then echo "n1"
	elif [ "$a" -ge 360000 ] && [ "$a" -le 376000 ]; then echo "n3"
	elif [ "$a" -ge 173800 ] && [ "$a" -le 178800 ]; then echo "n5"
	elif [ "$a" -ge 185000 ] && [ "$a" -le 192000 ]; then echo "n8"
	elif [ "$a" -ge 158200 ] && [ "$a" -le 172400 ]; then echo "n20"
	elif [ "$a" -ge 151600 ] && [ "$a" -le 160600 ]; then echo "n28"
	elif [ "$a" -ge 514000 ] && [ "$a" -le 524000 ]; then echo "n38"
	elif [ "$a" -ge 460000 ] && [ "$a" -le 480000 ]; then echo "n40"
	elif [ "$a" -ge 499200 ] && [ "$a" -le 538000 ]; then echo "n41"
	elif [ "$a" -ge 620000 ] && [ "$a" -le 653333 ]; then echo "n78"
	elif [ "$a" -ge 653334 ] && [ "$a" -le 680000 ]; then echo "n77"
	elif [ "$a" -ge 693334 ] && [ "$a" -le 733333 ]; then echo "n79"
	else echo "NR"
	fi
}

# 有 busybox timeout 就用；本固件已在 air6_defconfig 里打开该 applet。
with_timeout() {
	t_secs="$1"; shift
	if [ -x /usr/bin/timeout ]; then
		timeout "$t_secs" "$@"
	else
		"$@"
	fi
}

query() {
	exec 9>"$LOCK"
	flock -n 9 || return 75
	output="$(with_timeout 8 "$CLI" --"$1" 2>/dev/null)"
	rc=$?
	# ttyCMIPC6 是异步关闭的，冷却期间继续持锁，避免下一次请求插进来。
	sleep 2
	flock -u 9
	printf '%s' "$output"
	return $rc
}

at_query() {
	with_timeout 12 "$ATCLI" "$1" 2>/dev/null
}

write_state() {
	{
		printf 'UPDATED=%s\n'   "$now"
		printf 'UP=%s\n'        "$UP"
		printf 'UPTIME=%s\n'    "$UPTIME"
		printf 'WAN=%s\n'       "$WAN"
		printf 'IPV4=%s\n'      "$IPV4"
		printf 'SIM=%s\n'       "$SIM"
		printf 'REGISTRATION=%s\n' "$REGISTRATION"
		printf 'REGISTERED=%s\n'   "$REGISTERED"
		printf 'RAT=%s\n'       "$RAT"
		printf 'RAT_RAW=%s\n'   "$RAT_RAW"
		printf 'SIGNAL=%s\n'    "$SIGNAL"
		printf 'RSRP=%s\n'      "$RSRP"
		printf 'RADIO=%s\n'     "$RADIO"
		printf 'IMEI=%s\n'      "$IMEI"
		printf 'IMSI=%s\n'      "$IMSI"
		printf 'ICCID=%s\n'     "$ICCID"
		printf 'OPERATOR=%s\n'  "$OPERATOR"
		printf 'CESQ=%s\n'      "$CESQ"
		printf 'RSSI=%s\n'      "$RSSI"
		printf 'RSRQ=%s\n'      "$RSRQ"
		printf 'SINR=%s\n'      "$SINR"
		printf 'TEMP=%s\n'      "$TEMP"
		printf 'BAND=%s\n'      "$BAND"
		printf 'PCI=%s\n'       "$PCI"
		printf 'ARFCN=%s\n'     "$ARFCN"
		printf 'TAC=%s\n'       "$TAC"
		printf 'CELLID=%s\n'    "$CELLID"
	} >"$STATE_NEW" && mv "$STATE_NEW" "$STATE"
}

# 单实例保护：mkdir 原子锁，procd respawn 或多个 start 时只保留一个采集循环
LOCKDIR=/var/run/air6-modem-status.lockdir
if ! mkdir "$LOCKDIR" 2>/dev/null; then
	old="$(cat "$LOCKDIR/pid" 2>/dev/null)"
	if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
		exit 0
	fi
	rm -rf "$LOCKDIR"
	mkdir "$LOCKDIR" 2>/dev/null || exit 0
fi
echo $$ > "$LOCKDIR/pid"

trap 'rm -f "$STATE_NEW"; rm -rf "$LOCKDIR"; exit 0' TERM INT EXIT

config_load
sleep "${start_delay:-25}"

last_registration=0
last_radio=0
last_identity=0
last_detail=0
last_temp=0
SIM=unknown
REGISTRATION=unknown
REGISTERED=NO
RAT=UNKNOWN
RAT_RAW=
SIGNAL=
RSRP=
RADIO=
IMEI=
IMSI=
ICCID=
OPERATOR=
CESQ=
RSSI=
RSRQ=
SINR=
TEMP=
BAND=
PCI=
ARFCN=
TAC=
CELLID=

while :; do
	now="$(date +%s)"
	NET_JSON="$(ubus call network.interface.$IFACE status 2>/dev/null)"
	UP="$(printf '%s' "$NET_JSON" | jsonfilter -e '@.up')"
	UPTIME="$(printf '%s' "$NET_JSON" | jsonfilter -e '@.uptime')"
	WAN="$(printf '%s' "$NET_JSON" | jsonfilter -e '@.l3_device')"
	IPV4=
	[ -n "$WAN" ] && IPV4="$(ip -4 -o addr show dev "$WAN" 2>/dev/null | sed -n 's/.* inet \([^ ]*\).*/\1/p' | head -n 1)"

	if [ "$UP" = true ] && [ -n "$IPV4" ]; then
		REGISTERED=YES
	else
		REGISTERED=NO
	fi

	# SIM 与注册态：mipc 看卡，AT 看注册
	if [ $((now - last_registration)) -ge "${registration_interval:-20}" ]; then
		value="$(query show_sim_status)"
		[ -n "$value" ] && SIM="$(clean_value "$value")"

		# NR SA 只上报 C5GREG；LTE 用 CEREG/ CREG。任一登记即视为已注册。
		parsed=""; regsrc=""
		for cmd in 'AT+C5GREG?' 'AT+CREG?' 'AT+CEREG?'; do
			value="$(at_query "$cmd")"
			p="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+[A-Z0-9]*REG:[[:space:]]*[0-9]*,[[:space:]]*\([0-9]*\).*/\1/p' | head -n 1)"
			case "$p" in
				1|5) parsed="$p"; regsrc="$cmd"; break ;;
			esac
			[ -n "$p" ] && [ -z "$parsed" ] && parsed="$p"
		done
		case "$parsed" in
			1) REGISTRATION="registered (home)"; REGISTERED=YES ;;
			5) REGISTRATION="registered (roaming)"; REGISTERED=YES ;;
			2) REGISTRATION="searching" ;;
			3) REGISTRATION="registration denied" ;;
			0) REGISTRATION="not registered" ;;
			*) [ -n "$parsed" ] && REGISTRATION="state $parsed" ;;
		esac
		# MIPC 注册态更可靠（AT 与 LuCI 页面共用 atcid，可能短暂 BUSY）。
		if [ "$REGISTERED" != YES ]; then
			value="$(query check_nw_status)"
			case "$value" in
				*HOME*) REGISTRATION="registered (home)"; REGISTERED=YES ;;
				*ROAMING*) REGISTRATION="registered (roaming)"; REGISTERED=YES ;;
				*SEARCH*) REGISTRATION="searching" ;;
				*DENIED*) REGISTRATION="registration denied" ;;
				*NOT_REG*|*NONE*) REGISTRATION="not registered" ;;
			esac
		fi
		last_registration="$now"
	fi

	# RAT / 射频开关
	if [ $((now - last_radio)) -ge "${radio_interval:-60}" ]; then
		value="$(query nw_get_rat)"
		[ -n "$value" ] && RAT_RAW="$(clean_value "$value")"
		if [ -z "$RAT_RAW" ] || [ "$RAT_RAW" = "UNKNOWN" ]; then
			value="$(at_query 'AT+COPS?')"
			act="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+COPS:[^,]*,[^,]*,"[^"]*",\([0-9]*\).*/\1/p' | head -n 1)"
			case "$act" in
				7) RAT_RAW="LTE" ;;
				10|11|12|13) RAT_RAW="NR5G" ;;
				"") ;;
				*) RAT_RAW="act=$act" ;;
			esac
		fi
		case "$RAT_RAW" in
			*5G*|*NR*) RAT=5G ;;
			*LTE*|*4G*) RAT=4G ;;
			*) RAT=OTHER ;;
		esac

		value="$(query nw_radio_state_get)"
		[ -n "$value" ] && RADIO="$(clean_value "$value")"

		# 小区信息：AT+ECELL 的 15 个字段（rat,cellid,tac,mcc,mnc,pci,rsrp,...）
		value="$(at_query 'AT+ECELL')"
		parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+ECELL:[[:space:]]*//p' | head -n 1)"
		if [ -n "$parsed" ]; then
			e_rat="$(printf '%s' "$parsed" | cut -d, -f2 | tr -d '" ')"
			CELLID="$(printf '%s' "$parsed" | cut -d, -f3 | tr -d '" ')"
			TAC="$(printf '%s' "$parsed" | cut -d, -f4 | tr -d '" ')"
			PCI="$(printf '%s' "$parsed" | cut -d, -f7 | tr -d '" ')"
			ARFCN="$(printf '%s' "$parsed" | cut -d, -f16 | tr -d '" ')"
			# 信号以 ECELL 为准（CESQ 的 rsrp/rsrq 字段常为 255=不可用）
			e_rsrp="$(printf '%s' "$parsed" | cut -d, -f8 | tr -d '" ')"
			e_sinr="$(printf '%s' "$parsed" | cut -d, -f13 | tr -d '" ')"
			e_rsrq="$(printf '%s' "$parsed" | cut -d, -f9 | tr -d '" ')"
			case "$e_rsrp" in ''|*[!0-9]*) ;; *) [ "$e_rsrp" -le 140 ] && E_RSRP="-$e_rsrp" ;; esac
			case "$e_rsrq" in ''|*[!0-9]*) ;; *) [ "$e_rsrq" -le 255 ] && [ "$e_rsrq" != 255 ] && E_RSRQ="$(awk -v v="$e_rsrq" 'BEGIN{printf "%.1f", -v/10}')" ;; esac
			case "$e_sinr" in ''|*[!0-9]*) ;; *) [ "$e_sinr" -lt 255 ] && E_SINR="$(awk -v v="$e_sinr" 'BEGIN{printf "%.1f", v/10}')" ;; esac
			SIGNAL="RSSI=${RSSI:-?} RSRP=${RSRP:-?} RSRQ=${RSRQ:-?}"
			case "$e_rat" in
				7) BAND="$(lte_band "$ARFCN")"; RAT_RAW="LTE"; RAT=4G ;;
				*) BAND="$(nr_band "$ARFCN")"; RAT_RAW="NR5G"; RAT=5G ;;
			esac
		fi

		last_radio="$now"
	fi

	# 身份信息：变化慢，默认 30 分钟刷一次
	if [ $((now - last_identity)) -ge "${identity_interval:-1800}" ]; then
		value="$(query get_imei)"
		[ -n "$value" ] && IMEI="$(clean_value "$value")"

		value="$(at_query 'AT+CIMI')"
		parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n '/^[0-9]\{14,16\}$/p' | head -n 1)"
		[ -n "$parsed" ] && IMSI="$parsed"

		value="$(at_query 'AT+ICCID')"
		parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+ICCID:[[:space:]]*\([0-9A-Fa-f]\{18,22\}\).*/\1/p' | head -n 1)"
		if [ -z "$parsed" ]; then
			value="$(at_query 'AT+CCID')"
			parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+CCID:[[:space:]]*\([0-9A-Fa-f]\{18,22\}\).*/\1/p' | head -n 1)"
		fi
		[ -n "$parsed" ] && ICCID="$parsed"

		value="$(at_query 'AT+COPS?')"
		parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+COPS:[[:space:]]*[^,]*,[^,]*,"\([^"]*\)".*/\1/p' | head -n 1)"
		[ -n "$parsed" ] && OPERATOR="$parsed"
		last_identity="$now"
	fi

	# 信号：+CESQ 前 6 个字段是 3GPP 标准顺序
	# <rxlev>,<ber>,<rscp>,<ecno>,<rsrq>,<rsrp>；本固件把额外字段追加在后，
	# 语义与 AIR6 的 5G SS-RSRQ/RSRP/SINR 不同，因此只用标准字段。
	if [ $((now - last_detail)) -ge "${detail_interval:-300}" ]; then
		value="$(at_query 'AT+CESQ')"
		parsed="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+CESQ:[[:space:]]*//p' | head -n 1)"
		if [ -n "$parsed" ]; then
			CESQ="$parsed"
			RSSI="$(printf '%s\n' "$parsed" | awk -F, '{ gsub(/ /, "", $1); if (($1+0) >= 0 && ($1+0) <= 63) printf "%d", $1 - 110 }')"
			RSRQ="$(printf '%s\n' "$parsed" | awk -F, '{ gsub(/ /, "", $5); if (($5+0) >= 0 && ($5+0) <= 34) printf "%.1f", ($5 - 39) / 2 }')"
			RSRP="$(printf '%s\n' "$parsed" | awk -F, '{ gsub(/ /, "", $6); if (($6+0) >= 0 && ($6+0) <= 97) printf "%d", $6 - 140 }')"
			# SINR 没有标准 CESQ 字段，留在页面显示为 "-"。
			SINR=
			SIGNAL="RSSI=${RSSI:-?} RSRP=${RSRP:-?} RSRQ=${RSRQ:-?}"

		fi
		last_detail="$now"
	fi

	# 模组温度：AT+QTEMP 有多路传感器，soc-max-thermal 是整芯片最高温
	if [ $((now - last_temp)) -ge "${temp_interval:-60}" ]; then
		value="$(at_query 'AT+QTEMP')"
		TEMP="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+QTEMP:"soc-max-thermal","\([-0-9.]*\)".*/\1/p' | head -n 1)"
		if [ -z "$TEMP" ]; then
			TEMP="$(printf '%s\n' "$value" | tr -d '\r' | sed -n 's/^+QTEMP:"SOC_On_Die","\([-0-9.]*\)".*/\1/p' | head -n 1)"
		fi
		last_temp="$now"
	fi

	[ -n "$E_RSRP" ] && RSRP="$E_RSRP"
	[ -n "$E_RSRQ" ] && RSRQ="$E_RSRQ"
	[ -n "$E_SINR" ] && SINR="$E_SINR"
	SIGNAL="RSSI=${RSSI:-?} RSRP=${RSRP:-?} RSRQ=${RSRQ:-?}"
	write_state
	sleep "${poll_seconds:-5}"
done

SINR=
