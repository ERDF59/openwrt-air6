#!/bin/sh /etc/rc.common

USE_PROCD=1

#PROCD_DEBUG=1

START=99

NAME=event_trigger_logging
PROG=/usr/bin/event_trigger_logging
LOG_SIGUSR1="10"

start_service() {
	echo "start event_trigger_logging"
	procd_open_instance event_trigger_logging
	procd_set_param command /usr/bin/event_trigger_logging
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers()
{
	echo "event_trigger_logging service triggers"
	procd_add_reload_trigger "system"
}

reload_service() {
	echo "reload event_trigger_logging"
	procd_send_signal event_trigger_logging event_trigger_logging ${LOG_SIGUSR1}
}

