#!/bin/sh /etc/rc.common

START=99

STOP=01

USE_PROCD=1
NAME=arp_monitor


start_service()
{
	echo "start arp_monitor"
	procd_open_instance arp_monitor
	procd_set_param command /usr/bin/arp_monitor
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service()
{
    echo "stop arp_monitor"
    set_state shutdown
}

reload_service()
{
    echo "reload arp_monitor"
    stop
    start
}
