+static void mtk_nl80211_rx_ch_switch_event(
+				struct wpa_driver_nl80211_data *drv,
+				u32 subcmd,
+				u8 *data, size_t data_len)
+{
+	struct nlattr *tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_MAX + 1];
+	struct i802_bss *bss;
+	union wpa_event_data wpa_data;
+	int ifidx;
+	int ret;
+
+	ret = nla_parse(tb, MTK_NL80211_VENDOR_ATTR_CH_SWITCH_MAX, (struct nlattr *) data, data_len, NULL);
+	if (ret)
+		return;
+
+	ifidx = nla_get_u32(tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_IF_INDEX]);
+	bss = get_bss_ifindex(drv, ifidx);
+	if (bss == NULL) {
+		wpa_printf(MSG_WARNING, "nl80211: Unknown ifindex (%d) for channel switch, ignoring",
+			   ifidx);
+		return;
+	}
+
+	if (!tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_FREQ])
+		return;
+
+	os_memset(&wpa_data, 0, sizeof(wpa_data));
+	wpa_data.ch_switch.freq = nla_get_u32(tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_FREQ]);
+
+	/* Get VHT params */
+	if (tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_WIDTH])
+		wpa_data.ch_switch.ch_width = convert2width(
+			nla_get_u32(tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_WIDTH]));
+	if (tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_CENTER_FREQ1])
+		wpa_data.ch_switch.cf1 = nla_get_u32(
+			tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_CENTER_FREQ1]);
+	if (tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_CENTER_FREQ2])
+		wpa_data.ch_switch.cf2 = nla_get_u32(
+			tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_CENTER_FREQ2]);
+	if (tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_COUNT])
+		wpa_data.ch_switch.count = nla_get_u32(
+			tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_COUNT]);
+
+	/* Check HT params */
+	if (tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_TYPE]) {
+		wpa_data.ch_switch.ht_enabled = 1;
+		wpa_data.ch_switch.ch_offset = 0;
+
+		switch (nla_get_u32(tb[MTK_NL80211_VENDOR_ATTR_CH_SWITCH_CHANNEL_TYPE])) {
+		case NL80211_CHAN_NO_HT:
+			wpa_data.ch_switch.ht_enabled = 0;
+			break;
+		case NL80211_CHAN_HT20:
+			break;
+		case NL80211_CHAN_HT40PLUS:
+			wpa_data.ch_switch.ch_offset = 1;
+			break;
+		case NL80211_CHAN_HT40MINUS:
+			wpa_data.ch_switch.ch_offset = -1;
+			break;
+		}
+	} else if (wpa_data.ch_switch.ch_width && wpa_data.ch_switch.cf1) {
+		/* This can happen for example with VHT80 ch switch */
+		wpa_data.ch_switch.ch_offset = calculate_chan_offset(
+							wpa_data.ch_switch.ch_width,
+						    wpa_data.ch_switch.freq,
+						    wpa_data.ch_switch.cf1,
+						    wpa_data.ch_switch.cf2);
+		wpa_printf(MSG_DEBUG, "nl80211: Calculated channel offset: %d",
+			   wpa_data.ch_switch.ch_offset);
+	} else {
+		wpa_printf(MSG_WARNING, "nl80211: Unknown secondary channel information - following channel definition calculations may fail");
+	}
+
+	wpa_printf(MSG_INFO, "nl80211: %s event on freq %d MHz, ht: %d, "
+		"offset: %d, width: %d, cf1: %dMHz, cf2: %dMHz cs_count=%d",
+		subcmd == MTK_NL80211_VENDOR_EVENT_CH_SWITCH_STARTED ?
+			"CH_SWITCH_STARTED" : "CH_SWITCH",
+		wpa_data.ch_switch.freq,
+		wpa_data.ch_switch.ht_enabled,
+		wpa_data.ch_switch.ch_offset,
+		wpa_data.ch_switch.ch_width,
+		wpa_data.ch_switch.cf1,
+		wpa_data.ch_switch.cf2,
+		wpa_data.ch_switch.count);
+
+	drv->assoc_freq = wpa_data.ch_switch.freq;
+	switch (subcmd) {
+	case MTK_NL80211_VENDOR_EVENT_CH_SWITCH_STARTED:
+		wpa_supplicant_event(bss->ctx, EVENT_CH_SWITCH_STARTED, &wpa_data);
+		break;
+	case MTK_NL80211_VENDOR_EVENT_CH_SWITCH:
+		bss->freq = wpa_data.ch_switch.freq;
+		wpa_supplicant_event(bss->ctx, EVENT_CH_SWITCH, &wpa_data);
+		break;
+	default:
+		wpa_printf(MSG_DEBUG, "nl80211: Unknown vendor event %d received", subcmd);
+		break;
+	}
+}
