#!/bin/sh /etc/rc.common
# Air6 front-panel LED controller (AW9523B channels).

START=97
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && return 0

	procd_open_instance
	procd_set_param command /usr/bin/air6-panel-led
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
