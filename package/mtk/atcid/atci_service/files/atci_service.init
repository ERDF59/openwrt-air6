#!/bin/sh /etc/rc.common

START=96
#STOP=48

USE_PROCD=1
NAME=atci_service

start_service() {
	echo "start atci_service"

	procd_open_instance
	procd_set_param command /usr/bin/atci_service
	procd_set_param limits core="unlimited"
	procd_set_param respawn
	# forward stdout and stderr of the command to logd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service()
{
	echo "atci_service reload_service"

	stop
	start
}