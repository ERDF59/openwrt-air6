config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	# Both Ethernet jacks are LAN; the modem (modem5g) is the uplink.
	option ports 'lan wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.99.1/24'

config interface 'modem5g'
	option proto 'ql_datacall'
	option iptype '3'
	option auto_conf '1'
